{
  "expo": {
    "name": "brickd",
    "slug": "brickd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brick-logo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/brick-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/brick-adaptive.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Brick'd uses your location to find grocery stores near you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Brick'd uses your camera to scan product barcodes and look up their nutrition."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ]
  }
}
