{
  "expo": {
    "name": "brickd",
    "slug": "brickd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Brick'd uses your location to find grocery stores near you."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Brick'd uses your camera to scan product barcodes and look up their nutrition."
        }
      ]
    ]
  }
}
